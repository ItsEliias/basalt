# Supabase — client-safe values only (URL + publishable key). Copy to .env.
# The service-role key must NEVER appear here or anywhere in app/.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Licensed map tile provider (optional — dev CARTO tiles apply when unset).
# Documented options in packages/training/src/route-map.ts (Stadia / MapTiler).
EXPO_PUBLIC_TILE_URL=
EXPO_PUBLIC_TILE_ATTRIBUTION=
