{
  "expo": {
    "name": "Basalt",
    "slug": "basalt",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1115",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.itseliias.basalt"
    },
    "android": {
      "package": "com.itseliias.basalt",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_BONE_MASS",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_BODY_WATER_MASS",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.READ_ELEVATION_GAINED",
        "android.permission.health.READ_SPEED",
        "android.permission.health.READ_POWER"
      ]
    },
    "plugins": [
      "react-native-health-connect",
      "@maplibre/maplibre-react-native",
      "expo-notifications",
      "./plugins/withForegroundServiceTypes.js",
      "./plugins/withNotifeeMavenRepo.js",
      "./plugins/withHealthConnectQueries.js",
      "./plugins/withHealthConnectPermissionDelegate.js",
      "./plugins/withDisableForceDark.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BasaltToday",
              "label": "Basalt — Today",
              "description": "Energy remaining and water, as of your last open — never invented.",
              "minWidth": "180dp",
              "minHeight": "80dp",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Basalt uses the camera to scan food barcodes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Basalt records your walks with GPS so you can see your route, pace and splits."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Basalt uses the microphone so you can speak a meal instead of typing it.",
          "speechRecognitionPermission": "Basalt uses speech recognition to turn what you say into a food description.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ]
  }
}